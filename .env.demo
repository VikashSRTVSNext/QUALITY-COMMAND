# Standalone demo mode. Loaded by `vite --mode demo` / `vite build --mode demo`.
#
# This file is committed on purpose: it contains no secrets and the whole point
# is that the demo build is reproducible without local setup.

# Switches src/main.tsx onto the fixture-backed transport. Nothing else reads it.
VITE_DATA_MODE=demo

# ── Production-call guard ───────────────────────────────────────────────────
# A deliberately non-resolvable host. The demo serves every request from
# fixtures and throws on an unmatched URL, so these should never be dialled —
# but if the transport shim were ever bypassed, a request would fail DNS instead
# of reaching the plant. `.invalid` is reserved for exactly this (RFC 2606).
VITE_API_URL=http://demo.invalid/api/factory-command-center
VITE_DASHBOARD_STREAM_URL=http://demo.invalid/api/factory-command-center/dashboard/stream

# Leaves the app's own built-in mocks ON for the four legacy axios endpoints, so
# /quality/defect/:code renders without any network call. The demo route table
# also covers those paths as a backstop.
VITE_USE_MOCKS=true

# Snapshot replay speed. 1 = as recorded, 2 = twice as fast.
VITE_DEMO_SSE_SPEED=1
