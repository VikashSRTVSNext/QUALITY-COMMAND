{
  "name": "factory-command-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-palette.mjs && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "check:palette": "node scripts/check-palette.mjs",
    "preview": "vite preview",
    "dev:demo": "vite --mode demo",
    "build:demo": "node scripts/validate-demo-fixtures.mjs && node scripts/check-palette.mjs && tsc && vite build --mode demo",
    "preview:demo": "vite preview --mode demo --outDir dist-demo",
    "serve:demo": "node scripts/serve-demo.mjs",
    "demo:fixtures": "node scripts/generate-demo-fixtures.mjs",
    "demo:validate": "node scripts/validate-demo-fixtures.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.7.2",
    "framer-motion": "^11.3.8",
    "lucide-react": "^0.408.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^6.30.4",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^7.15.0",
    "@typescript-eslint/parser": "^7.15.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.2.2",
    "vite": "^5.3.3"
  }
}
