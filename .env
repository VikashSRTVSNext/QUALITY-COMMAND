# Copy to `.env.local` and adjust. Vite only exposes vars prefixed with VITE_.

# ── Quality Command Center live feed ────────────────────────────────────────
# SSE endpoint that emits the `snapshot` event (see QualityLayout.tsx).
# Local docker stack (plcm-yield-mock api service):
VITE_DASHBOARD_SSE_URL=http://localhost:8000/dashboard/stream
# Leave unset to fall back to the legacy tunnel URL baked into the component.

# ── Production/generic data layer (endpoints.ts) ────────────────────────────
# REST base URL for the axios client. Default: /api/v1
# VITE_API_BASE_URL=http://localhost:8000
# Serve mock fixtures instead of hitting the backend (default: true).
VITE_USE_MOCKS=false

# ── Optional generic live bridges (providers.tsx) ───────────────────────────
# Only wired when set; used by the production-lines socket/SSE bridge.
# VITE_WS_URL=ws://localhost:8000/ws
# VITE_SSE_URL=http://localhost:8000/events
