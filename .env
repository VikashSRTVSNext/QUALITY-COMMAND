# Copy to `.env.local` and adjust. Vite only exposes vars prefixed with VITE_.
# `.env.local` is gitignored and overrides this file — use it for local hosts.
#
# All backend hosts resolve in src/core/api/config.ts. Do not read
# import.meta.env.VITE_API_* directly in components.

# ── Factory Command Center API (product yield, safety, ERI, SSE stream) ─────
# Deployed NESC service. This is what the dashboard talks to by default —
# it stays live regardless of whether your local stack is running.
VITE_API_URL=https://digitwin.dyn.nesc.nokia.net/api/factory-command-center

# To develop against the local docker stack (plcm-yield-mock api service),
# put this in `.env.local` instead:
#   VITE_API_URL=http://localhost:8000

# SSE snapshot feed. Leave unset: config.ts derives it as
# `${VITE_API_URL}/dashboard/stream`. Only set this when the stream is served
# from a different host than the REST API.
# VITE_DASHBOARD_SSE_URL=http://localhost:8000/dashboard/stream

# ── Generic data layer (core/api/endpoints.ts → /production/lines, etc.) ────
# Separate route surface from the dashboard API above. Default: /api/v1
# VITE_API_BASE_URL=http://localhost:8000
# Serve mock fixtures instead of hitting the backend (default: true).
VITE_USE_MOCKS=false

# ── Optional generic live bridges (providers.tsx) ───────────────────────────
# Only wired when set; used by the production-lines socket/SSE bridge.
# VITE_WS_URL=ws://localhost:8000/ws
# VITE_SSE_URL=http://localhost:8000/events
