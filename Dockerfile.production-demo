FROM node:20-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci --legacy-peer-deps
COPY . .
ENV VITE_BASE_PATH=/factory-command-center/production-demo/ \
    VITE_API_URL=https://digitwin.dyn.nesc.nokia.net/api/factory-command-center \
    VITE_API_BASE_URL=https://digitwin.dyn.nesc.nokia.net/api/factory-command-center \
    VITE_DASHBOARD_STREAM_URL=https://digitwin.dyn.nesc.nokia.net/api/factory-command-center/dashboard/stream \
    VITE_USE_MOCKS=false
RUN npm run build

FROM nginx:alpine
RUN apk add --no-cache --upgrade 'libxslt>=1.1.43-r4' && \
    sed -i -E 's@^[[:space:]]*pid[[:space:]]+[^;]+;@pid /tmp/nginx.pid;@; /^[[:space:]]*user[[:space:]]/d' /etc/nginx/nginx.conf
COPY nginx/production-demo.conf /etc/nginx/conf.d/default.conf
COPY --from=build --chown=101:101 /app/dist/ /usr/share/nginx/html/factory-command-center/production-demo/
USER 101:101
RUN nginx -t
EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]